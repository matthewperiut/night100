def runtime_args():
    result = [str(ROOT / 'build/mac/night100'), str(ROOT / 'game/SLUS_203.49')]
    if args.benchmark_binary:
        if args.action != 'gameplay-benchmark':
            raise SystemExit('--benchmark-binary requires gameplay-benchmark')
        binary=args.benchmark_binary.resolve()
        if not binary.is_file() or not os.access(binary, os.X_OK):
            raise SystemExit(f'Benchmark binary is not executable: {binary}')
        result[0]=str(binary)
    result += ['--renderer', args.renderer]
    result += ['--graphics', args.graphics]
    if args.controller_prompts:
        result += ['--controller-prompts', args.controller_prompts]
    if args.cpu_scale != 1:
        result += ['--cpu-scale', str(args.cpu_scale)]
    if args.record_gs:
        args.record_gs.resolve().parent.mkdir(parents=True, exist_ok=True)
        result += ['--record-gs', str(args.record_gs.resolve())]
    iso = args.iso
    if not iso and Path('analysis/disc.json').exists():
        iso = Path(json.loads(Path('analysis/disc.json').read_text())['iso'])
    if iso:
        result += ['--iso', str(iso.resolve())]
    if args.skip_videos:
        result += ['--skip-videos']
    if args.metrics:
        result += ['--metrics']
    if args.record_inputs:
        result += ['--record-inputs', str(args.record_inputs.resolve())]
    if args.replay_inputs:
        result += ['--replay-inputs', str(args.replay_inputs.resolve())]
    if args.replay_session is not None:
        if args.replay_session<1:
            raise SystemExit('Replay session number must be positive')
        replay_root=Path(os.environ.get('NIGHT100_REPLAY_DIRECTORY',ROOT/'logs'/'replays'))
        result += ['--replay-session',str((replay_root/f'session-{args.replay_session:06d}').resolve())]
    if args.replay_continue:
        result += ['--replay-continue']
    if args.dump_state:
        result += ['--dump-state', str(args.dump_state.resolve())]
    if args.record_inputs:
        recording=args.record_inputs.resolve()
        recording.parent.mkdir(parents=True, exist_ok=True)
        if recording.exists() or Path(str(recording)+'.json').exists():
            raise SystemExit(f'Input recording or launch manifest already exists: {recording}. '
                             'Choose a new recording filename to preserve the previous attempt.')
        metadata={'command':result, 'host':platform.platform(),
                  'binary_sha256':hashlib.sha256(Path(result[0]).read_bytes()).hexdigest(),
                  'elf_sha256':hashlib.sha256(Path(result[1]).read_bytes()).hexdigest(),
                  'git_commit':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),
                  'source_hashes':{str(p):hashlib.sha256(p.read_bytes()).hexdigest()
                      for p in sorted([Path('night100'),Path('CMakeLists.txt'),
                          *Path('src').rglob('*.cpp'),*Path('src').rglob('*.h'),
                          Path('controllers/prompts.map'),*Path('controllers/sw').glob('*'),
                          *Path('shaders').glob('*'),*Path('patches').glob('*.patch')]) if p.is_file()}}
        with Path(str(recording)+'.json').open('x') as manifest:
            json.dump(metadata,manifest,indent=2);manifest.write('\n')
    return result


def launch_game():
    command = runtime_args()
    try:
        run(command)
    finally:
        # Startup can fail before the runtime opens the recording. Keep its
        # provenance, but release the name so that the same command can retry.
        if args.record_inputs and not args.record_inputs.resolve().exists():
            manifest = Path(str(args.record_inputs.resolve()) + '.json')
            if manifest.exists():
                directory = LOGS / 'input-runs'
                directory.mkdir(parents=True, exist_ok=True)
                descriptor, archived = tempfile.mkstemp(prefix='failed-launch-', suffix='.json', dir=directory)
                os.close(descriptor)
                shutil.move(manifest, archived)
                print(f'No input recording was created. Launch metadata saved to {archived}; '
                      'you can retry the same recording filename.', file=sys.stderr)


def package_desktop():
    output = (args.output or Path('out/night100')).absolute()
    if output.exists() or output.is_symlink():
        raise SystemExit(f'Choose a new --output folder; already exists: {output}')
    iso = args.iso
    if iso is None:
        images = sorted(ROOT.glob('*.iso'))
        if len(images) != 1:
            raise SystemExit('Pass the local disc image using --iso PATH')
        iso = images[0]
    iso = iso.resolve()
    if not Path('game/SLUS_203.49').is_file() or not Path('analysis/functions.json').is_file():
        prepare(iso)
    build()
    run([sys.executable, 'tools/package_release.py', '--iso', str(iso),
         '--binary', str(ROOT/'build/mac/night100'), '--output', str(output)])

