                    'binary_sha256': hashlib.sha256(Path(command[0]).read_bytes()).hexdigest(),
                    'elf_sha256': hashlib.sha256(Path(command[1]).read_bytes()).hexdigest(),
                    'cpu_scale': args.cpu_scale, 'gpu_scale': args.gpu_scale,
