        if args.capture:
            args.capture.resolve().parent.mkdir(parents=True, exist_ok=True)
            command += ['--capture', str(args.capture.resolve()), '--capture-after', str(max(1, args.seconds-2))]
        manifest = {'command': command, 'host': platform.platform(), 'host_cpu_count': os.cpu_count(),
                    'render_environment': {key: env.get(key) for key in
                        ('NIGHT100_REFERENCE_NATIVE_RTT', 'NIGHT100_REFERENCE_UNIFORMS',
