        with (output / 'boot.log').open('w') as stream:
            result = subprocess.run(command, env=env, stdout=stream, stderr=subprocess.STDOUT, timeout=args.seconds+30)
        run([sys.executable, 'tools/gameplay_report.py', str(output), '--cpu-scale', str(args.cpu_scale),
             '--gpu-scale', str(args.gpu_scale), '--duration', str(args.seconds), '--exit-code', str(result.returncode)])
