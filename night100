def run(args, log=None, timeout=None):
    print('+ ' + ' '.join(map(str, args)), flush=True)
    if log:
        with (LOGS / log).open('w') as stream:
            try:
                subprocess.run(args, check=True, stdout=stream, stderr=subprocess.STDOUT, timeout=timeout)
            except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
                print((LOGS / log).read_text(errors='replace')[-10000:], file=sys.stderr)
                raise
    else:
        subprocess.run(args, check=True, timeout=timeout)


def compiler_cache_args():
    """Share object compilations across build directories when ccache is installed."""
    launcher = shutil.which('ccache')
    if not launcher:
        return []
    return [f'-DCMAKE_C_COMPILER_LAUNCHER={launcher}', f'-DCMAKE_CXX_COMPILER_LAUNCHER={launcher}']


def verified_chain(chain):
    """True when the checkout equals its pinned commit plus every patch in order.

    Replays the chain on a scratch export of the pinned commit and compares the
    result with the live worktree. A fully patched tree therefore needs no
    patch-by-patch reverse checks, which fail once later patches share context.
    """
    import filecmp, tempfile
    pin = subprocess.check_output(['git', '-C', 'vendor/PS2Recomp', 'rev-parse', 'HEAD'], text=True).strip()
    with tempfile.TemporaryDirectory(prefix='ps2-chain-') as scratch:
        archive = subprocess.run(['git', '-C', 'vendor/PS2Recomp', 'archive', pin], capture_output=True)
        if archive.returncode:return False
        subprocess.run(['tar', '-x', '-C', scratch], input=archive.stdout, check=True)
        for patch_path in chain:
            if subprocess.run(['git', 'apply', str(patch_path.resolve())], cwd=scratch, capture_output=True).returncode:
                return False
        diff = subprocess.run(['diff', '-rq', '-x', '.git', scratch, 'vendor/PS2Recomp'], capture_output=True)
        return diff.returncode == 0


def bootstrap():
    for command in ('git', 'cmake', 'ninja', '7zz', 'pkg-config', 'clang++'):
        if not shutil.which(command):
            raise SystemExit(f'Missing {command}. Install prerequisites: brew install cmake ninja sevenzip ffmpeg pkgconf')
    deps = json.loads(Path('dependencies.json').read_text())
    for name, dep in deps.items():
        path = Path(dep['path'])
        if not path.exists():
            run(['git', 'clone', '--no-checkout', '--depth', '1', dep['url'], str(path)], 'fetch-' + name + '.log')
            run(['git', '-C', str(path), 'fetch', '--depth', '1', 'origin', dep['commit']], 'fetch-' + name + '.log')
            run(['git', '-C', str(path), 'checkout', '--detach', dep['commit']])
        actual = subprocess.check_output(['git', '-C', str(path), 'rev-parse', 'HEAD'], text=True).strip()
        if actual != dep['commit']:
            raise SystemExit(f'{path}: expected pinned revision {dep["commit"]}, found {actual}')
    # Patches overlap by context, so a per-patch reverse check fails once later
    # patches are applied. A marker in the checkout's git dir records the verified
    # digest of the whole chain (pristine pin + sorted patches); it is not in the worktree.
    chain = sorted(Path('patches').glob('*.patch'))
    digest = hashlib.sha256(b''.join(p.read_bytes() for p in chain)).hexdigest()
    marker = Path('vendor/PS2Recomp') / subprocess.check_output(
        ['git', '-C', 'vendor/PS2Recomp', 'rev-parse', '--git-path', 'night100-patch-state'], text=True).strip()
    if not (marker.exists() and marker.read_text().strip() == digest):
        if not verified_chain(chain):
            for patch_path in chain:
                patch = str(patch_path.resolve())
                check = subprocess.run(['git', '-C', 'vendor/PS2Recomp', 'apply', '--reverse', '--check', patch], capture_output=True)
                if check.returncode:
                    run(['git', '-C', 'vendor/PS2Recomp', 'apply', '--check', patch])
                    run(['git', '-C', 'vendor/PS2Recomp', 'apply', patch])
        marker.write_text(digest + '\n')
    run(['cmake', '-S', 'vendor/PS2Recomp', '-B', 'build/toolchain', '-G', 'Ninja',
         '-DCMAKE_BUILD_TYPE=Release', '-DPS2X_BUILD_RUNTIME=OFF', '-DPS2X_BUILD_STUDIO=OFF',
         '-DPS2X_BUILD_TEST=OFF'], 'configure-toolchain.log')
    run(['cmake', '--build', 'build/toolchain', '--target', 'ps2_analyzer', 'ps2_recomp', '-j', '8'], 'build-toolchain.log')


def prepare(iso):
    if not Path('build/toolchain/ps2xAnalyzer/ps2_analyzer').exists():
        bootstrap()
    if not iso:
        images = list(ROOT.glob('*.iso'))
        if len(images) != 1:
            raise SystemExit('Pass the local disc image using --iso PATH')
        iso = images[0]
    iso = Path(iso).resolve()
    # Skip FMVs and padding: gameplay files take ~793 MiB instead of duplicating the disc.
    run(['7zz', 'x', '-y', '-ogame', str(iso), 'SLUS_203.49', 'SYSTEM.CNF', 'SD2.INI',
         'IOPRP243.IMG', 'MODULES/*', '*.HIP', 'FMV/THQLOGO.PSS', 'FMV/HILOGO.PSS',
         'FMV/WBLOGO.PSS', 'FMV/RW4.PSS', 'FMV/INTRO.PSS', '-r'], 'extract.log')
    digest = hashlib.sha256(Path('game/SLUS_203.49').read_bytes()).hexdigest()
    if digest != ELF_SHA:
        raise SystemExit(f'Unsupported ELF SHA256: {digest}')
    run([sys.executable, 'tools/disc.py', str(iso)], 'disc.log')
    run([sys.executable, 'tools/dwarf1.py', 'game/SLUS_203.49'], 'dwarf.log')
    run(['build/toolchain/ps2xAnalyzer/ps2_analyzer', 'game/SLUS_203.49', 'analysis/analyzer.toml'], 'analyzer.log')
    recompile()


def recompile():
    run([sys.executable, 'tools/prepare_config.py'])
    stage = Path('build/generated-stage')
    if stage.exists():
        for file in stage.glob('*'):
            if file.is_file():
                file.unlink()
    run(['build/toolchain/ps2xRecomp/ps2_recomp', 'analysis/scooby.toml'], 'recompile.log')
    # Upstream can return success even when its report contains instruction errors.
    report = (LOGS / 'recompile.log').read_text()
    if '[error]' in report:
        raise SystemExit('Recompiler reported errors; see logs/recompile.log')
    run([sys.executable, 'tools/sync_generated.py'])
    Path('generated/.night100-codegen.json').write_text(json.dumps(codegen_fingerprint(), sort_keys=True)+'\n')


def codegen_fingerprint():
    paths = ['build/toolchain/ps2xRecomp/ps2_recomp', 'analysis/scooby.toml',
             'analysis/functions.json', 'tools/prepare_config.py', 'tools/sync_generated.py', 'game/SLUS_203.49']
    return {p: hashlib.sha256(Path(p).read_bytes()).hexdigest() for p in paths}


@contextlib.contextmanager
def build_lock():
    # A second launcher waits for the current build, rather than running two
    # Ninja/code-generation processes in the same output tree.
    with (LOGS / '.build.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def switch_devkit():
    # switch.specs consumes this during linking as well as CMake configuration.
    devkit = Path(os.environ.get('DEVKITPRO', '/opt/devkitpro')).resolve()
    if not (devkit / 'cmake/Switch.cmake').is_file():
        raise SystemExit('Install devkitPro switch-dev, switch-zlib and switch-libpng first; see the README')
    os.environ['DEVKITPRO'] = str(devkit)
    os.environ['DEVKITA64'] = str(devkit / 'devkitA64')
    return devkit


def build_gpu_probe():
    with build_lock():
        bootstrap()
        switch_devkit()
        run(['cmake', '-S', 'platform/switch', '-B', 'build/switch-gpu-probe', '-G', 'Ninja',
             f'-DCMAKE_TOOLCHAIN_FILE={ROOT}/cmake/switch/toolchain.cmake', '-DCMAKE_BUILD_TYPE=Release',
             '-DNIGHT100_GPU_PROBE_ONLY=ON', '-DNIGHT100_DEKO_VALIDATION=ON'], 'configure-switch-probe.log')
        run(['cmake', '--build', 'build/switch-gpu-probe', '--target', 'night100_gpu_probe_nro', '-j', '8'], 'build-switch-probe.log')


def build(platform_name='mac'):
    with build_lock():
        bootstrap()
        if not Path('game/SLUS_203.49').exists():
            raise SystemExit('Run ./night100 prepare first to extract and configure the local disc')
        stamp=Path('generated/.night100-codegen.json')
        if not stamp.exists() or json.loads(stamp.read_text()) != codegen_fingerprint():
            print('Recompiler or configuration changed; regenerating game code.', flush=True)
            recompile()
        run([sys.executable, 'tools/controller_assets.py', '--game', 'game', '--output', 'controllers'], 'controller-assets.log')
        if platform_name == 'switch':
            devkit = switch_devkit()
            run([sys.executable, 'tools/bootstrap_switch_video.py', '--devkitpro', str(devkit)], 'switch-video-build.log')
            run(['cmake', '-S', 'platform/switch', '-B', 'build/switch', '-G', 'Ninja',
                 f'-DCMAKE_TOOLCHAIN_FILE={ROOT}/cmake/switch/toolchain.cmake',
                 '-DCMAKE_BUILD_TYPE=Release',
                 '-DNIGHT100_DEKO_VALIDATION=' + ('ON' if args.gpu_validation else 'OFF')] + compiler_cache_args(), 'configure-switch.log')
            run(['cmake', '--build', 'build/switch', '--target', 'night100_nro', '-j', '8'], 'build-switch.log')
            return
        run(['cmake', '-S', '.', '-B', 'build/mac', '-G', 'Ninja', '-DCMAKE_BUILD_TYPE=Release',
             f'-DFETCHCONTENT_BASE_DIR={ROOT}/build/toolchain/_deps'] + compiler_cache_args(), 'configure-mac.log')
        run(['cmake', '--build', 'build/mac', '--target', 'night100', '-j', '8'], 'build-mac.log')


def symbol(value):
    address = int(value, 0)
    funcs = json.loads(Path('analysis/functions.json').read_text())
    matches = [f for f in funcs if f['start'] <= address < f['end']]
    if matches:
        for f in matches:
            print(f'{f["name"]}+0x{address-f["start"]:x} [{f["start"]:#x}, {f["end"]:#x}) {f["source"]}')
    else:
        for f in csv.DictReader(Path('analysis/combined.csv').open()):
            if int(f['start'], 0) <= address < int(f['end'], 0):
                print(f'{f["name"]} [{f["start"]}, {f["end"]}) (heuristic SDK range)')


