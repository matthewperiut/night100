        if args.reference_particles: command += ['--reference-particles']
        if args.resource_cache: command += ['--resource-cache', args.resource_cache]
        if args.render_image: command += ['--render-image', args.render_image]
        if args.replay_session is not None: command += ['--replay-session',str(args.replay_session)]
        run(command)
    elif args.action == 'package':
        if args.platform == 'switch':
            if not Path('game/SLUS_203.49').is_file() or not Path('analysis/functions.json').is_file():
                prepare(args.iso)
            build('switch')
            resources = (args.resources or ROOT/'out/switch-resources').absolute()
            if not (resources/'resource-manifest.json').is_file():
                if args.resources:
                    raise SystemExit(f'No resource-manifest.json in --resources {resources}')
                images = [args.iso] if args.iso else sorted(ROOT.glob('*.iso'))
                if len(images) != 1:
                    raise SystemExit('Pass the local disc image using --iso PATH')
                run([sys.executable, 'tools/package_resources.py', '--iso', str(images[0].resolve()), '--output', str(resources)])
            run([sys.executable, 'tools/package_switch.py', '--resources', str(resources),
                 '--output', str((args.output or ROOT/'out/switch/night100').absolute())])
        else:
            package_desktop()
    elif args.action == 'all':
        bootstrap()
        prepare(args.iso)
        build(args.platform)
        run([sys.executable, 'tools/check_analysis.py'])
        if args.platform == 'mac':
            run(['build/mac/night100', '--self-test'], 'self-test.log', timeout=30)
    elif args.action == 'test':
        build()
        run([sys.executable, 'tools/check_analysis.py'])
