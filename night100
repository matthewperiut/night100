        if args.skip_videos: command += ['--skip-videos']
        if args.gpu_self_test: command += ['--gpu-self-test']
        if args.cpu_profile: command += ['--cpu-profile']
        if args.native_cpu_profile: command += ['--native-cpu-profile']
        if args.cpu_kernel_benchmark: command += ['--cpu-kernel-benchmark']
        if args.switch_clocks: command += ['--switch-clocks', args.switch_clocks]
        if args.internal_res: command += ['--internal-res', args.internal_res]
        if args.platform == 'switch': command += ['--aspect', args.aspect]
