+// Cumulative VU1 microcode counters for diagnostics. Written only from the
+// VIF1 and MSCAL path, which runs on the EE executor thread; read between frames.
+struct VU1MicrocodeStats
+{
+    uint64_t mpgPackets = 0;       // VIF MPG packets processed
+    uint64_t mpgBytes = 0;         // microcode bytes carried by MPG packets (clamped to VU1 code memory)
+    uint64_t mpgUnchanged = 0;     // MPG packets whose bytes already matched VU1 code memory
+    uint64_t mscalCalls = 0;       // VIF MSCAL/MSCALF starts
+    uint64_t mscntCalls = 0;       // VIF MSCNT starts
+    uint64_t imageHashes = 0;      // code-image hashes computed (code generation changed since the last MSCAL)
+    uint64_t distinctImages = 0;   // distinct code-image hashes recorded
+    uint64_t distinctOverflow = 0; // images that could not be recorded because the hash table was full
+    uint64_t vu1Cycles = 0;        // VU1 cycles reported by MSCAL executions
+    uint64_t vu1ExecNs = 0;        // host nanoseconds spent inside MSCAL microprogram execution
+};
+
+// One-line summary of cumulative counters; diff two snapshots for per-frame values.
+std::string formatVU1MicrocodeStats(const VU1MicrocodeStats &stats);
+
