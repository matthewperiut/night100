+std::string formatVU1MicrocodeStats(const VU1MicrocodeStats &stats)
+{
+    char text[512];
+    std::snprintf(text, sizeof(text),
+                  "vu1 mpg=%llu mpg_bytes=%llu mpg_unchanged=%llu mscal=%llu mscnt=%llu "
+                  "image_hashes=%llu distinct_images=%llu distinct_overflow=%llu "
+                  "vu1_cycles=%llu vu1_exec_us=%.1f",
+                  static_cast<unsigned long long>(stats.mpgPackets),
+                  static_cast<unsigned long long>(stats.mpgBytes),
+                  static_cast<unsigned long long>(stats.mpgUnchanged),
+                  static_cast<unsigned long long>(stats.mscalCalls),
+                  static_cast<unsigned long long>(stats.mscntCalls),
+                  static_cast<unsigned long long>(stats.imageHashes),
+                  static_cast<unsigned long long>(stats.distinctImages),
+                  static_cast<unsigned long long>(stats.distinctOverflow),
+                  static_cast<unsigned long long>(stats.vu1Cycles),
+                  static_cast<double>(stats.vu1ExecNs) / 1000.0);
+    return text;
+}
+
+void PS2Memory::recordVU1Mscal()
+{
+    ++m_vu1Stats.mscalCalls;
+    const uint64_t generation = getVU1CodeGeneration();
+    if (generation == m_vu1StatsHashedGeneration || !m_vu1Code)
+        return;
+    m_vu1StatsHashedGeneration = generation;
+    ++m_vu1Stats.imageHashes;
+
+    // Word-wise FNV-style hash over the whole 16KB micro memory, then a final mix.
+    uint64_t hash = 14695981039346656037ull;
+    for (uint32_t offset = 0; offset < PS2_VU1_CODE_SIZE; offset += 8)
+    {
+        uint64_t word = 0;
+        std::memcpy(&word, m_vu1Code + offset, sizeof(word));
+        hash = (hash ^ word) * 1099511628211ull;
+    }
+    hash ^= hash >> 31;
+    hash *= 0x9E3779B97F4A7C15ull;
+    hash ^= hash >> 29;
+    if (hash == 0)
+        hash = 1;
+
+    const uint32_t mask = kVU1ImageTableSize - 1u;
+    for (uint32_t probe = 0; probe < kVU1ImageTableSize; ++probe)
+    {
+        uint64_t &slot = m_vu1ImageTable[(static_cast<uint32_t>(hash) + probe) & mask];
+        if (slot == hash)
+            return;
+        if (slot == 0)
+        {
+            slot = hash;
+            ++m_vu1Stats.distinctImages;
+            return;
+        }
+    }
+    ++m_vu1Stats.distinctOverflow;
+}
