+    // Direct JAL: calls fn inline when the function table still maps targetPc to fn,
+    // otherwise falls back to dispatchGuestBranch. The table entry is the only
+    // per-target guard, so replaceFunction is observed on the next call. The
+    // 8-cycle checkpoint charge and the post-call PC checks match dispatchGuestBranch.
+    bool dispatchDirectCall(uint8_t *rdram,
+                            R5900Context *ctx,
+                            RecompiledFunction fn,
+                            uint32_t targetPc,
