@@ -596,5 +609,44 @@
 extern const uint32_t g_ps2RecompiledFunctionTableEnd;
 extern const uint32_t g_ps2RecompiledFunctionTableSlotCount;
 extern PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[];
+
+inline bool PS2Runtime::dispatchDirectCall(uint8_t *rdram,
+                                           R5900Context *ctx,
+                                           RecompiledFunction fn,
+                                           uint32_t targetPc,
+                                           uint32_t sourcePc,
+                                           uint32_t fallthroughPc,
+                                           const char *debugName)
+{
+    const bool tableHit = (targetPc & 3u) == 0u &&
+                          targetPc >= g_ps2RecompiledFunctionTableBase &&
+                          targetPc < g_ps2RecompiledFunctionTableEnd &&
+                          g_ps2RecompiledFunctionTable[(targetPc - g_ps2RecompiledFunctionTableBase) >> 2] == fn;
+    if (!tableHit)
+    {
+        return dispatchGuestBranch(rdram, ctx, targetPc, sourcePc, fallthroughPc, GuestBranchKind::DirectCall, debugName);
+    }
 
+    ctx->pc = targetPc;
+    // Same charge as dispatchGuestBranch (EeScheduler::kGuestDispatchCycles, pinned by a static_assert in ps2_runtime.cpp).
+    constexpr uint32_t kDirectCallCycles = 8u;
+    if (hasEeScheduler() && eeCheckpointDue(kDirectCallCycles))
+    {
+        return false;
+    }
+
+    const uint64_t unwindSequence = guestUnwindSequence();
+    fn(rdram, ctx, this);
+
+    if (isStopRequested() || ctx->pc == 0u || guestUnwindSequence() != unwindSequence)
+    {
+        return false;
+    }
+    if (ctx->pc == targetPc)
+    {
+        ctx->pc = fallthroughPc;
+    }
+    return ctx->pc == fallthroughPc;
+}
+
 #endif // PS2_RUNTIME_H
