+namespace {
+using SharedBytes=std::shared_ptr<const std::vector<uint8_t>>;
+
+// Process-wide whole-file cache. Lock order, outermost first:
+//   open cache mutex -> disc mutex -> loadMutex -> mutex.
+// `mutex` guards the index, LRU, statistics and mode, and is only held for
+// in-memory bookkeeping. It is never held during file I/O, so statistics and mode
+// queries from other threads cannot block behind a load. `loadMutex` serializes
+// loads so a file is read once. The off path takes no lock at all.
+struct FileCache {
+    struct Entry { std::string key; SharedBytes data; };
+    std::atomic<uint8_t> mode{static_cast<uint8_t>(ResourceCacheMode::Off)};
+    std::mutex mutex;
+    std::mutex loadMutex;
+    uint64_t capacity=0;
+    uint64_t bytes=0;
+    std::list<Entry> lru; // front is most recently used
+    std::unordered_map<std::string,std::list<Entry>::iterator> index;
+    ResourceCacheStats stats;
+
+    void evictWhileOver(uint64_t incoming) { // requires mutex
+        while(!lru.empty() && bytes+incoming>capacity) {
+            bytes-=lru.back().data->size();
+            index.erase(lru.back().key);
+            lru.pop_back();
+            ++stats.evictions;
+        }
+    }
+    // Looks up a resident file under mutex; promotes it on a hit.
+    SharedBytes lookupLocked(const std::string& key) {
+        auto found=index.find(key);
+        if(found==index.end())return {};
+        lru.splice(lru.begin(),lru,found->second);
+        ++stats.hits;
+        return found->second->data;
+    }
+    // Reads the whole file in bounded chunks, checking every return value. Runs with
+    // no cache mutex held. Returns null on any short or failed read.
+    static SharedBytes loadWholeFile(const std::filesystem::path& path,uint64_t size) {
+        FILE* stream=openFile(path);
+        if(!stream)return {};
+        auto data=std::make_shared<std::vector<uint8_t>>(static_cast<size_t>(size));
+        constexpr size_t chunkBytes=1024u*1024u;
+        size_t done=0;
+        bool ok=true;
+        std::clearerr(stream);
+        while(done<data->size()) {
+            const size_t want=std::min(chunkBytes,data->size()-done);
+            const size_t got=std::fread(data->data()+done,1,want,stream);
+            if(got==0) {ok=false;break;}
+            done+=got;
+        }
+        if(std::ferror(stream))ok=false;
+        std::fclose(stream);
+        return ok && done==data->size() ? data : SharedBytes{};
+    }
+    SharedBytes acquire(const std::filesystem::path& path,bool allowEvict) {
+        if(mode.load(std::memory_order_relaxed)==static_cast<uint8_t>(ResourceCacheMode::Off))return {};
+        const std::string key=path.string();
+        {
+            std::lock_guard lock(mutex);
+            if(auto hit=lookupLocked(key))return hit;
+        }
+        std::lock_guard load(loadMutex);
+        uint64_t limit=0;
+        {
+            std::lock_guard lock(mutex);
+            // Another thread may have loaded it while this one waited for loadMutex.
+            if(auto hit=lookupLocked(key))return hit;
+            limit=capacity;
+        }
+        std::error_code error;
+        const uint64_t size=std::filesystem::file_size(path,error);
+        if(error || size>limit) {
+            std::lock_guard lock(mutex);
+            ++stats.uncached;
+            return {};
+        }
+        SharedBytes data=loadWholeFile(path,size); // I/O with no cache mutex held
+        std::lock_guard lock(mutex);
+        if(!data || mode.load(std::memory_order_relaxed)==static_cast<uint8_t>(ResourceCacheMode::Off)) {
+            ++stats.uncached;
+            return {};
+        }
+        if(size>capacity || (!allowEvict && bytes+size>capacity)) {
+            ++stats.uncached;
+            return {};
+        }
+        if(allowEvict)evictWhileOver(size);
+        lru.push_front({key,data});
+        index[key]=lru.begin();
+        bytes+=size;
+        ++stats.loads;
+        return data;
+    }
+};
+FileCache& fileCache() {
+    static FileCache cache;
+    return cache;
 }
 }
 
