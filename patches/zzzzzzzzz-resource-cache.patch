+void ResourceDisc::setCacheMode(ResourceCacheMode mode,uint64_t capBytes) {
+    auto& cache=fileCache();
+    std::lock_guard lock(cache.mutex);
+    cache.stats=ResourceCacheStats{};
+    cache.capacity=mode==ResourceCacheMode::Off?0:capBytes;
+    cache.lru.clear();
+    cache.index.clear();
+    cache.bytes=0;
+    cache.mode.store(static_cast<uint8_t>(mode),std::memory_order_relaxed);
+    cache.evictWhileOver(0);
+}
+
+ResourceCacheMode ResourceDisc::cacheMode() noexcept {
+    return static_cast<ResourceCacheMode>(fileCache().mode.load(std::memory_order_relaxed));
+}
+
+ResourceCacheStats ResourceDisc::cacheStats() {
+    auto& cache=fileCache();
+    std::lock_guard lock(cache.mutex);
+    ResourceCacheStats result=cache.stats;
+    result.files=cache.index.size();
+    result.bytes=cache.bytes;
+    return result;
+}
+
+void ResourceDisc::prefetch() {
+    if(cacheMode()==ResourceCacheMode::Off)return;
+    for(const auto& extent:m_impl->extents)
+        if(extent.encoding!=1)fileCache().acquire(extent.path,false);
+}
