 namespace ps2x {
 
+// Process-wide cache of source files referenced by compact discs.
+//  * Off (default): every read streams from the source file, as before.
+//  * WholeFile: a source file is loaded entirely on first access, and later reads
+//    are served from memory. Least-recently-used whole files are evicted when the
+//    cap is exceeded. A file larger than the cap is never cached and keeps streaming.
+//  * WholeFilePrefetch: as WholeFile, and each disc opened afterwards loads every
+//    source file its manifest lists, in manifest order, while they fit under the cap.
+//    The manifest describes the whole disc, not scenes, so this is not per-scene.
+// Cached files are assumed immutable while cached. Changing a source file on disk
+// while the cache holds it is not detected.
+enum class ResourceCacheMode : uint8_t {
+    Off = 0,
+    WholeFile = 1,
+    WholeFilePrefetch = 2,
+};
+
+struct ResourceCacheStats {
+    uint64_t files = 0;     // whole files currently resident
+    uint64_t bytes = 0;     // bytes of resident files
+    uint64_t loads = 0;     // whole-file loads since the mode was set
+    uint64_t hits = 0;      // reads served from a resident file
+    uint64_t evictions = 0; // resident files removed to honor the cap
+    uint64_t uncached = 0;  // loads declined: over the cap, or no room without eviction
+};
+
 // A lossless logical disc assembled from loose assets and bounded gap blocks.
 // open returns null for an ordinary file/directory. Recognized corrupt manifests
 // throw, so a broken package cannot silently become a different disc image.
+//
+// Threading: read() and prefetch() may be called from any thread. Each disc
+// serializes its reads on an internal mutex. open() is also thread-safe. The
+// cache is process-wide and internally synchronized.
 class ResourceDisc {
 public:
+    static constexpr uint64_t kDefaultCacheBytes = 512ull * 1024ull * 1024ull;
+
+    // Sets the process-wide cache policy. Drops every resident file and resets the
+    // statistics, whatever the new mode is. Callers should set the mode once, at startup.
+    static void setCacheMode(ResourceCacheMode mode, uint64_t capBytes = kDefaultCacheBytes);
+    [[nodiscard]] static ResourceCacheMode cacheMode() noexcept;
+    [[nodiscard]] static ResourceCacheStats cacheStats();
+
     static std::shared_ptr<ResourceDisc> open(const std::filesystem::path& path);
     ~ResourceDisc();
     uint64_t size() const noexcept;
+    // Loads every source file this disc lists that fits under the cap, without evicting.
+    // Does nothing unless the cache is enabled.
+    void prefetch();
     // Like fread: EOF is a successful short read; errors return false.
     bool read(uint64_t offset, void* destination, size_t length, size_t& bytesRead);
 
