+// Immutable completed GPU image. Leases keep its texture/context alive. The
+// producer may recycle storage only after all leases and consumer GPU work end.
+// These hooks require GL 3.3-style shared resources, never CPU-mapped GPU RAM.
+class GSGpuPresentation
+{
+public:
+    virtual ~GSGpuPresentation() = default;
+    virtual uint32_t textureId() const = 0;
+    virtual uint32_t textureWidth() const = 0;
+    virtual uint32_t textureHeight() const = 0;
+    // Called in the window's current context, before sampling and after the
+    // render batch is flushed. Waits are GPU/server-side, not CPU polling.
+    virtual void waitForDraw() const = 0;
+    virtual void finishDraw() const = 0;
+    // Explicit diagnostic path: materialize the immutable completed image in
+    // the existing 640x512 RGBA CPU layout. Ordinary presentation never calls it.
+    virtual bool readPixels(std::vector<uint8_t> &outPixels) const = 0;
+};
+
 struct PresentationFrame
 {
     std::vector<uint8_t> pixels;
