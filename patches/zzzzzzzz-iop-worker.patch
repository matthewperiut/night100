+    void IopSubsystem::setWorkerEnabled(bool enabled, uint64_t quantumCycles)
+    {
+        if (!enabled)
+        {
+            m_impl->worker.reset();
+            return;
+        }
+        if (m_impl->worker)
+            return;
+        m_impl->worker = std::make_unique<ps2x::iop::IopWorker>(
