new file mode 100644
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/iop_worker.h
@@ -0,0 +1,181 @@
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <thread>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+namespace ps2x::iop
+{
+    // Runs IOP work on one dedicated host thread. The worker executes, in order:
+    //  * IOP cycle credits, from a single-producer single-consumer ring;
+    //  * jobs the EE thread asks for with runOnWorker (RPCs, module control, SIF
+    //    notifications), which execute IOP code on the worker and let the EE wait;
+    //  * blocking jobs the worker asks for with eeCall, which run on the EE thread;
+    //  * deferred jobs the worker queues with deferToEe, which run on the EE thread.
+    // Ring credit always runs before queued jobs, so EE-visible order equals the
+    // order in which the EE thread submitted work.
+    //
+    // Ownership rule: IOP state is touched by the worker thread. The EE thread touches
+    // it only while the worker is suspended inside a blocking job it requested (an
+    // inline call nested in that job is the inline reentrancy the IOP already has).
+    //
+    // Determinism: drain points depend only on the EE credit stream (quantum
+    // boundaries, ring capacity, and explicit quiesce calls), and EE-side job execution
+    // happens only inside drains and waits, so EE memory a job observes is fixed by
+    // that stream and not by thread timing.
+    class IopWorker
+    {
+    public:
+        using Execute = std::function<void(uint64_t credit)>;
+        using StartHook = std::function<void()>;
+
+        // startHook runs once on the worker thread before the first job.
+        // creditCapacity is rounded up to a power of two.
+        IopWorker(Execute execute, uint64_t quantumCycles, StartHook startHook = StartHook(),
+                  size_t creditCapacity = 4096);
+        ~IopWorker();
+
+        IopWorker(const IopWorker &) = delete;
+        IopWorker &operator=(const IopWorker &) = delete;
+
+        // EE thread only. Queues credit, and may drain at a quantum boundary.
+        void submit(uint64_t credit);
+
+        // EE thread only. Waits until queued credit and jobs have run and EE jobs are
+        // serviced. Returns at once while the worker is suspended in an EE job.
+        void quiesce();
+
+        // EE thread only, not from a serviced job. Quiesces, then joins. Idempotent.
+        void stop();
+
+        // EE thread only. True while the EE thread is running a blocking job the worker
+        // requested. The worker is then suspended on this stack, so IOP work may run inline.
+        [[nodiscard]] bool eeInsideBlockingJob() const noexcept { return m_eeBlockingJobDepth != 0u; }
+
+        [[nodiscard]] static bool onWorkerThread() noexcept { return tlsCurrent != nullptr; }
+
+        // EE thread only. Runs f on the worker thread after all earlier credit and
+        // jobs, and blocks the EE thread until f returns. While it waits, the EE thread
+        // services EE jobs the worker queues, so the worker's blocking calls complete.
+        template <class F, class Result = std::invoke_result_t<F &>>
+        Result runOnWorker(F &&f)
+        {
+            if constexpr (std::is_void_v<Result>)
+            {
+                std::function<void()> job = [&f] { f(); };
+                runOnWorkerJob(job);
+            }
+            else
+            {
+                std::optional<Result> out;
+                std::function<void()> job = [&] { out.emplace(f()); };
+                runOnWorkerJob(job);
+                return std::move(*out);
+            }
+        }
+
+        // Runs f on the EE thread, in FIFO order with other worker jobs, and blocks
+        // the worker until f has completed. Outside the worker thread this calls f directly.
+        template <class F, class Result = std::invoke_result_t<F &>>
+        static Result eeCall(F &&f)
+        {
+            IopWorker *worker = tlsCurrent;
+            if constexpr (std::is_void_v<Result>)
+            {
+                if (!worker)
+                {
+                    f();
+                    return;
+                }
+                std::function<void()> job = [&f] { f(); };
+                worker->postBlocking(job);
+            }
+            else
+            {
+                if (!worker)
+                    return f();
+                std::optional<Result> out;
+                std::function<void()> job = [&] { out.emplace(f()); };
+                worker->postBlocking(job);
+                return std::move(*out);
+            }
+        }
+
+        // Queues f to run on the EE thread at the next drain, in FIFO order, without
+        // blocking the worker. f must own its captured data. Outside the worker thread
+        // this calls f directly.
+        template <class F>
+        static void deferToEe(F &&f)
+        {
+            IopWorker *worker = tlsCurrent;
+            if (!worker)
+            {
+                f();
+                return;
+            }
+            worker->postDeferred(std::function<void()>(std::forward<F>(f)));
+        }
+
+    private:
+        struct EeJob
+        {
+            std::function<void()> fn;
+            bool *done = nullptr; // set for blocking jobs; the worker waits on it
+        };
+        struct WorkerJob
+        {
+            std::function<void()> fn;
+            bool *done = nullptr; // set when the worker has finished the job
+        };
+
+        void run();
+        void runOnWorkerJob(std::function<void()> &job);
+        void postBlocking(std::function<void()> &job);
+        void postDeferred(std::function<void()> job);
+        void runOneEeJobLocked(std::unique_lock<std::mutex> &lock);
+        void drainLocked(std::unique_lock<std::mutex> &lock);
+        void flushOverflowLocked();
+        void publish(uint64_t credit);
+        void wakeWorkerIfSleeping();
+        [[nodiscard]] bool hasRingSpace() const noexcept;
+
+        static thread_local IopWorker *tlsCurrent;
+
+        Execute m_execute;
+        uint64_t m_quantumCycles;
+        size_t m_capacity; // power of two
+        std::vector<uint64_t> m_ring;
+        StartHook m_startHook;
+
+        // EE-thread state (only the EE thread touches these).
+        uint64_t m_cyclesSinceBoundary = 0;
+        uint64_t m_creditsSinceBoundary = 0;
+        std::deque<uint64_t> m_overflow; // credit that did not fit the ring during a nested submit
+        unsigned m_eeBlockingJobDepth = 0u; // blocking jobs the EE thread is running on this stack
+
+        // Shared state.
+        std::atomic<uint64_t> m_tail{0}; // written by the EE thread
+        std::atomic<uint64_t> m_head{0}; // written by the worker thread
+        std::atomic<bool> m_workerSleeping{false};
+        std::atomic<bool> m_eeWaiting{false};
+
+        std::mutex m_mutex; // guards the job queues, the flags below and the condition variables
+        std::condition_variable m_workerCv; // worker waits: sleeping, or a blocking job completion
+        std::condition_variable m_eeCv;     // EE waits: drain condition, a queued EE job, or a worker job
+        std::deque<EeJob> m_eeJobs;
+        std::deque<WorkerJob> m_workerJobs;
+        bool m_workerJobRunning = false;
+        bool m_stop = false;
+
+        std::thread m_thread; // declared last: starts after every member above is constructed
+    };
+}
diff --git a/ps2xIOP/src/iop_worker.cpp b/ps2xIOP/src/iop_worker.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xIOP/src/iop_worker.cpp
@@ -0,0 +1,300 @@
+#include "ps2x/iop/iop_worker.h"
+
+#include <cstdlib>
+#include <stdexcept>
+
+namespace ps2x::iop
+{
+    thread_local IopWorker *IopWorker::tlsCurrent = nullptr;
+
+    namespace
+    {
+        size_t roundUpToPowerOfTwo(size_t value)
+        {
+            size_t result = 1u;
+            while (result < value)
+                result <<= 1u;
+            return result;
+        }
+    }
+
+    IopWorker::IopWorker(Execute execute, uint64_t quantumCycles, StartHook startHook, size_t creditCapacity)
+        : m_execute(std::move(execute)),
+          m_quantumCycles(quantumCycles ? quantumCycles : 1u),
+          m_capacity(roundUpToPowerOfTwo(creditCapacity < 2u ? 2u : creditCapacity)),
+          m_ring(m_capacity),
+          m_startHook(std::move(startHook)),
+          m_thread(&IopWorker::run, this)
+    {
+    }
+
+    IopWorker::~IopWorker()
+    {
+        try
+        {
+            stop();
+        }
+        catch (...)
+        {
+            // Destruction must not throw, and a joinable thread must not be destroyed.
+            // Reaching here means the object was destroyed from inside a blocking EE job.
+            std::abort();
+        }
+    }
+
+    bool IopWorker::hasRingSpace() const noexcept
+    {
+        return m_tail.load(std::memory_order_relaxed) - m_head.load(std::memory_order_acquire) < m_capacity;
+    }
+
+    void IopWorker::publish(uint64_t credit)
+    {
+        // Only the EE thread writes m_tail, so the relaxed load reads its own value.
+        const uint64_t tail = m_tail.load(std::memory_order_relaxed);
+        m_ring[tail & (m_capacity - 1u)] = credit;
+        m_tail.store(tail + 1u, std::memory_order_seq_cst);
+    }
+
+    void IopWorker::wakeWorkerIfSleeping()
+    {
+        // Pairs with the worker's sleep handshake: it sets m_workerSleeping and then
+        // checks for work under the mutex, so either it sees this credit or we see it sleeping.
+        if (m_workerSleeping.load(std::memory_order_seq_cst))
+        {
+            std::lock_guard lock(m_mutex);
+            m_workerCv.notify_all();
+        }
+    }
+
+    void IopWorker::submit(uint64_t credit)
+    {
+        if (credit == 0u)
+            return;
+        if (m_eeBlockingJobDepth == 0u &&
+            (m_cyclesSinceBoundary >= m_quantumCycles || m_creditsSinceBoundary + 1u >= m_capacity))
+        {
+            // Quantum boundary, or the ring would fill. These depend only on the EE
+            // credit stream. Drain: wait for the worker and service its EE jobs.
+            std::unique_lock lock(m_mutex);
+            drainLocked(lock);
+            m_cyclesSinceBoundary = 0u;
+            m_creditsSinceBoundary = 0u;
+        }
+        m_cyclesSinceBoundary += credit;
+        ++m_creditsSinceBoundary;
+        if (m_overflow.empty() && hasRingSpace())
+        {
+            publish(credit);
+            wakeWorkerIfSleeping();
+            return;
+        }
+        // Reached only from a nested submit while the worker is suspended, where a
+        // drain would deadlock. Keep the credit in FIFO order behind the ring.
+        m_overflow.push_back(credit);
+        std::lock_guard lock(m_mutex);
+        flushOverflowLocked();
+    }
+
+    void IopWorker::flushOverflowLocked()
+    {
+        bool published = false;
+        while (!m_overflow.empty() && hasRingSpace())
+        {
+            publish(m_overflow.front());
+            m_overflow.pop_front();
+            published = true;
+        }
+        if (published && m_workerSleeping.load(std::memory_order_seq_cst))
+            m_workerCv.notify_all();
+    }
+
+    void IopWorker::quiesce()
+    {
+        if (onWorkerThread())
+            return;
+        std::unique_lock lock(m_mutex);
+        drainLocked(lock);
+    }
+
+    void IopWorker::stop()
+    {
+        if (onWorkerThread())
+            throw std::logic_error("IopWorker::stop called from the worker thread");
+        {
+            std::unique_lock lock(m_mutex);
+            if (m_eeBlockingJobDepth != 0u)
+                throw std::logic_error("IopWorker::stop called from a blocking EE job");
+            drainLocked(lock);
+            m_stop = true;
+            m_workerCv.notify_all();
+        }
+        if (m_thread.joinable())
+            m_thread.join();
+    }
+
+    // Runs the first queued EE job. The caller holds the lock; it is released while the job runs.
+    void IopWorker::runOneEeJobLocked(std::unique_lock<std::mutex> &lock)
+    {
+        EeJob job = std::move(m_eeJobs.front());
+        m_eeJobs.pop_front();
+        const bool blocking = job.done != nullptr;
+        if (blocking)
+            ++m_eeBlockingJobDepth;
+        lock.unlock();
+        try
+        {
+            job.fn();
+        }
+        catch (...)
+        {
+            // Callbacks report failure through their return values.
+        }
+        lock.lock();
+        if (blocking)
+        {
+            --m_eeBlockingJobDepth;
+            *job.done = true;
+            m_workerCv.notify_all();
+        }
+    }
+
+    void IopWorker::drainLocked(std::unique_lock<std::mutex> &lock)
+    {
+        // The EE thread is inside a blocking job the worker requested. The worker is suspended
+        // on this stack with IOP state mid-credit, so the caller proceeds inline, as the
+        // inline reentrancy does. Waiting here would deadlock.
+        if (m_eeBlockingJobDepth != 0u)
+            return;
+        for (;;)
+        {
+            if (!m_eeJobs.empty())
+            {
+                runOneEeJobLocked(lock);
+                continue;
+            }
+            flushOverflowLocked();
+            // Announce the wait before the final check, so the worker's post-consume check
+            // cannot miss it (Dekker pattern).
+            m_eeWaiting.store(true, std::memory_order_seq_cst);
+            if (m_overflow.empty() && m_eeJobs.empty() && !m_workerJobRunning &&
+                m_head.load(std::memory_order_seq_cst) == m_tail.load(std::memory_order_relaxed))
+            {
+                m_eeWaiting.store(false, std::memory_order_seq_cst);
+                return;
+            }
+            m_eeCv.wait(lock);
+            m_eeWaiting.store(false, std::memory_order_seq_cst);
+        }
+    }
+
+    void IopWorker::runOnWorkerJob(std::function<void()> &job)
+    {
+        if (onWorkerThread() || m_eeBlockingJobDepth != 0u)
+        {
+            // Already on the worker, or inside a job the worker is suspended on: run inline.
+            job();
+            return;
+        }
+        std::unique_lock lock(m_mutex);
+        bool done = false;
+        m_workerJobs.push_back(WorkerJob{job, &done});
+        m_workerCv.notify_all(); // the worker may be sleeping
+        while (!done)
+        {
+            if (!m_eeJobs.empty())
+            {
+                runOneEeJobLocked(lock);
+                continue;
+            }
+            m_eeCv.wait(lock);
+        }
+    }
+
+    void IopWorker::postBlocking(std::function<void()> &job)
+    {
+        std::unique_lock lock(m_mutex);
+        bool done = false;
+        m_eeJobs.push_back(EeJob{job, &done});
+        m_eeCv.notify_all();
+        m_workerCv.wait(lock, [&done] { return done; });
+    }
+
+    void IopWorker::postDeferred(std::function<void()> job)
+    {
+        std::lock_guard lock(m_mutex);
+        m_eeJobs.push_back(EeJob{std::move(job), nullptr});
+        m_eeCv.notify_all();
+    }
+
+    void IopWorker::run()
+    {
+        tlsCurrent = this;
+        if (m_startHook)
+        {
+            try
+            {
+                m_startHook();
+            }
+            catch (...)
+            {
+                // A failed affinity request leaves the thread where the scheduler put it.
+            }
+        }
+        uint64_t head = 0u;
+        for (;;)
+        {
+            // Ring credit first: IOP credit always precedes jobs queued after it.
+            if (m_tail.load(std::memory_order_seq_cst) != head)
+            {
+                const uint64_t credit = m_ring[head & (m_capacity - 1u)];
+                try
+                {
+                    m_execute(credit);
+                }
+                catch (...)
+                {
+                    // The emulator contains its own errors; keep the queue and handoff alive.
+                }
+                ++head;
+                m_head.store(head, std::memory_order_seq_cst);
+                if (m_eeWaiting.load(std::memory_order_seq_cst))
+                {
+                    std::lock_guard lock(m_mutex);
+                    m_eeCv.notify_all();
+                }
+                continue;
+            }
+
+            std::unique_lock lock(m_mutex);
+            if (!m_workerJobs.empty())
+            {
+                WorkerJob job = std::move(m_workerJobs.front());
+                m_workerJobs.pop_front();
+                m_workerJobRunning = true;
+                lock.unlock();
+                try
+                {
+                    job.fn();
+                }
+                catch (...)
+                {
+                    // Errors inside an RPC are reported through its result.
+                }
+                lock.lock();
+                m_workerJobRunning = false;
+                if (job.done)
+                    *job.done = true;
+                m_eeCv.notify_all();
+                continue;
+            }
+            if (m_stop)
+                break;
+            m_workerSleeping.store(true, std::memory_order_seq_cst);
+            m_workerCv.wait(lock, [this, head] {
+                return m_tail.load(std::memory_order_seq_cst) != head || !m_workerJobs.empty() || m_stop;
+            });
+            m_workerSleeping.store(false, std::memory_order_seq_cst);
+        }
+        tlsCurrent = nullptr;
+    }
+}
