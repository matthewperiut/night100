+++ b/ps2xIOP/include/ps2x/iop/iop_routed_host.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include "ps2x/iop/iop_host.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace ps2x::iop
+{
+    // Forwards every IopHost call to an inner host. When the call comes from the IOP
+    // worker thread:
+    //  * host file operations (open, size, read, close, path translation), memory
+    //    card and guest-function calls run on the EE thread as blocking jobs, so all
+    //    host file I/O stays on the thread that owns the host filesystem sessions;
+    //  * submitted PCM is copied and handed to the EE thread as a deferred job, since
+    //    the audio sink may write capture files;
+    //  * everything else is forwarded directly. The adapter routes the EE-state
+    //    callbacks it owns (guest memory, SIF dispatch) itself.
+    // On any other thread every call is forwarded directly.
+    class IopEeRoutedHost final : public IopHost
+    {
+    public:
+        explicit IopEeRoutedHost(IopHost &inner) noexcept : m_inner(inner) {}
+
+        bool stopRequested() const noexcept override;
