+    void IopEeRoutedHost::submitAudioSamples(const int16_t *samples, size_t stereoFrames)
+    {
+        if (!IopWorker::onWorkerThread() || stereoFrames == 0)
+        {
+            m_inner.submitAudioSamples(samples, stereoFrames);
+            return;
+        }
+        // The sink may write capture files. Copy the frames and deliver them in order on the EE thread.
+        std::vector<int16_t> copy(samples, samples + stereoFrames * 2);
+        IopWorker::deferToEe([inner = &m_inner, copy = std::move(copy)] {
+            inner->submitAudioSamples(copy.data(), copy.size() / 2u);
+        });
+    }
