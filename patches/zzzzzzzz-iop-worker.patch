+                const uint64_t before = impl->emulator.cycles();
+                impl->emulator.runEeCycles(credit);
+                impl->counters.workerCredits.fetch_add(1u, std::memory_order_relaxed);
+                impl->counters.workerCycles.fetch_add(impl->emulator.cycles() - before, std::memory_order_relaxed);
+            },
+            quantumCycles,
+            m_impl->workerThreadHook);
+    }
