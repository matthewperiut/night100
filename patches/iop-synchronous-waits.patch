+    IopThread &IopKernel::beginGuestCall()
+    {
+        m_idleUntil = 0;
+        IopThread thread;
+        thread.id = static_cast<int>(m_nextThreadId++);
+        thread.state = IopThreadState::Running;
+        thread.guestCall = true;
+        thread.priority = 1;
+        auto [entry, inserted] = m_threads.emplace(thread.id, std::move(thread));
+        m_currentThread = &entry->second;
+        return entry->second;
+    }
+
+    void IopKernel::endGuestCall(int id, IopThread *previous)
+    {
+        m_idleUntil = 0;
+        m_threads.erase(id);
+        m_currentThread = previous;
+    }
+
