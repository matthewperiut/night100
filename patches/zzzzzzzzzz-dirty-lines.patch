diff --git a/ps2xRuntime/include/ps2_runtime.h b/ps2xRuntime/include/ps2_runtime.h
--- a/ps2xRuntime/include/ps2_runtime.h
+++ b/ps2xRuntime/include/ps2_runtime.h
@@ -241,6 +241,16 @@
     return static_cast<uint8_t>((valueHi >> ((byteIndex - 8u) * 8u)) & 0xFFu);
 }
 
+#if defined(NIGHT100_DIRTY_LINES)
+// Set by every ordinary guest store for night100's render image: one byte per
+// 64-byte guest RAM line (scanned) and one byte per 8-byte granule (consulted
+// per byte where render-private bytes share a line with update writes).
+inline constexpr uint32_t kPs2DirtyLineShift = 6u;
+inline constexpr uint32_t kPs2DirtyGranuleShift = 3u;
+alignas(64) inline uint8_t g_ps2DirtyLines[PS2_RAM_SIZE >> kPs2DirtyLineShift];
+alignas(64) inline uint8_t g_ps2DirtyGranules[PS2_RAM_SIZE >> kPs2DirtyGranuleShift];
+#endif
+
 inline void ps2TraceGuestWrite(uint8_t *rdram,
                                uint32_t guestAddr,
                                uint32_t size,
@@ -249,6 +259,15 @@
                                const char *op,
                                const R5900Context *ctx)
 {
+#if defined(NIGHT100_DIRTY_LINES)
+    const uint32_t dirtyOffset = guestAddr & PS2_RAM_MASK;
+    g_ps2DirtyLines[dirtyOffset >> kPs2DirtyLineShift] = 1u;
+    g_ps2DirtyGranules[dirtyOffset >> kPs2DirtyGranuleShift] = 1u;
+    if (size > 8u)
+    {
+        g_ps2DirtyGranules[(dirtyOffset >> kPs2DirtyGranuleShift) + 1u] = 1u; // 16-byte stores are aligned
+    }
+#endif
     (void)rdram;
     (void)guestAddr;
     (void)size;
