+void EeScheduler::excludeHostTime(uint64_t nanoseconds)
+{
+    if (!nanoseconds) return;
+    std::lock_guard lock(m_eventMutex);
+    if (m_statePauseDepth) return;
+    const auto maximum = Clock::duration::max();
+    if (nanoseconds > uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(maximum).count()))
+        throw std::runtime_error("Inactive host interval exceeds the scheduler clock range");
+    const auto shift = std::chrono::duration_cast<Clock::duration>(std::chrono::nanoseconds(nanoseconds));
+    for (const auto &deadline : m_deadlines)
+        if (deadline.hostDeadline.time_since_epoch() > maximum - shift)
+            throw std::runtime_error("Inactive host interval overflows an EE deadline");
+    for (auto &deadline : m_deadlines) deadline.hostDeadline += shift;
