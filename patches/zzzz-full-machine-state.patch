+void PS2Runtime::saveMachineState(ps2x::state::Writer& ar) {
+    m_eeScheduler->validateStateSerializable();
+    m_gs.prepareStateSave();
+    // These also preflight nonserializable external transactions. Host
+    // handles are never persisted; their logical tables reopen on restore.
+    const auto iop=m_iopSubsystem->saveState(),host=m_iopHost->saveState(),vfs=m_vfs.saveState(),audio=m_audioBackend.saveState();
