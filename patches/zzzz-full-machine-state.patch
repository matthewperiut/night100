+    ar(uint32_t(2));
+    saveCoreState(ar);
+    m_gs.state(ar);
+    ar(iop,host,vfs,audio,cd,audioStub,sif,memoryCard,syscalls,files,mpeg,pad,gsStub,dmaStub,libc);
+}
+void PS2Runtime::loadMachineState(ps2x::state::Reader& ar) {
+    pauseStateClocks();
+    uint32_t version=0;ar(version);if(version!=2)throw std::runtime_error("Unsupported machine-state schema");
+    loadCoreState(ar);
+    m_gs.state(ar);
+    std::vector<uint8_t> iop,host,vfs,audio,cd,audioStub,sif,memoryCard,syscalls,files,mpeg,pad,gsStub,dmaStub,libc;
+    ar(iop,host,vfs,audio,cd,audioStub,sif,memoryCard,syscalls,files,mpeg,pad,gsStub,dmaStub,libc);
+    m_iopSubsystem->loadState(iop);
+    m_iopHost->loadState(host);
+    m_vfs.loadState(vfs);
+    m_audioBackend.loadState(audio);
+    ps2_stubs::loadCdState(cd);ps2_stubs::loadAudioStubState(audioStub);ps2_stubs::loadSifState(sif);
+    ps2_stubs::loadMemoryCardState(memoryCard);ps2_syscalls::loadSyscallState(syscalls);ps2_syscalls::loadFileIoState(files);
+    ps2_stubs::loadMpegState(mpeg);
+    ps2_stubs::loadPadState(pad);ps2_stubs::loadGsStubState(gsStub);ps2_stubs::loadDmaStubState(dmaStub);ps2_stubs::loadLibcState(libc);
+    m_restoredState=true;
+}
