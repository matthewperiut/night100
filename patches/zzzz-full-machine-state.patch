+void GSCpuBackend::DecodeTexture(const GSDrawState &source, uint32_t width, uint32_t height, std::vector<uint32_t> &out)
+{
+    if (!width || !height || width > 1024 || height > 1024)
+        throw std::invalid_argument("Invalid GS texture decode extent");
+    std::lock_guard<std::mutex> lock(m_mutex);
+    const auto& tex = source.context.tex0;
+    out.resize(size_t(width) * height);
+    const bool color16 = tex.psm == GS_PSM_CT16 || tex.psm == GS_PSM_CT16S;
+    if (m_vram && tex.tbw != 0 && (color16 || tex.psm == GS_PSM_CT32 || tex.psm == GS_PSM_CT24))
+    {
+        const auto* layout = SurfaceAddresses(tex.psm, tex.tbw, width, height);
+        if (layout)
+        {
+            // Under this mutex no VRAM write can interleave with the decode.
+            // Only the old first-page prefix and final cached page are visible
+            // outside the call. Preserve both, reading current VRAM after the
+            // first miss instead of copying 8 KiB at every later page crossing.
+            const uint32_t base = tex.tbp0 << 8u;
+            auto decode = [&]<bool SixteenBit, bool TwentyFourBit>() {
+                constexpr uint32_t alignment = SixteenBit ? 2u : 4u;
+                const size_t count = size_t(width) * height;
+                auto expand = [&](const uint8_t* bytes) -> uint32_t {
+                    if constexpr (SixteenBit)
+                    {
+                        uint16_t packed;
+                        std::memcpy(&packed, bytes, sizeof(packed));
+                        const uint32_t rgb = ((packed & 31u) << 3u) | (((packed >> 5u) & 31u) << 11u)
+                            | (((packed >> 10u) & 31u) << 19u);
+                        const uint32_t alpha = (packed & 0x8000u) ? source.texa.ta1
+                            : (source.texa.aem && rgb == 0u ? 0u : source.texa.ta0);
+                        return rgb | (alpha << 24u);
+                    }
+                    else
+                    {
+                        uint32_t raw;
+                        std::memcpy(&raw, bytes, sizeof(raw));
+                        if constexpr (TwentyFourBit)
+                        {
+                            raw &= 0xffffffu;
+                            const uint32_t alpha = source.texa.aem && raw == 0u ? 0u : source.texa.ta0;
+                            raw |= alpha << 24u;
+                        }
+                        return raw;
+                    }
+                };
+                const uint32_t firstAddress = (base + layout->offsets[0]) & (GSMem::MEMORY_SIZE - alignment);
+                const uint32_t firstPage = firstAddress & ~8191u;
+                const auto* cached = m_texturePageCache.Resolve(m_vram, firstAddress) - (firstAddress & 8191u);
+                size_t pixel = 0;
+                for (; pixel < count; ++pixel)
+                {
+                    const uint32_t address = (base + layout->offsets[pixel]) & (GSMem::MEMORY_SIZE - alignment);
+                    if ((address & ~8191u) != firstPage) break;
+                    out[pixel] = expand(cached + (address & 8191u));
+                }
+                if (pixel == count) return;
+                for (; pixel < count; ++pixel)
+                {
+                    const uint32_t address = (base + layout->offsets[pixel]) & (GSMem::MEMORY_SIZE - alignment);
+                    out[pixel] = expand(m_vram + address);
+                }
+                const uint32_t lastAddress = (base + layout->offsets[count - 1]) & (GSMem::MEMORY_SIZE - alignment);
+                m_texturePageCache.Invalidate();
+                m_texturePageCache.Resolve(m_vram, lastAddress);
+            };
+            if (color16) decode.template operator()<true, false>();
+            else if (tex.psm == GS_PSM_CT24) decode.template operator()<false, true>();
+            else decode.template operator()<false, false>();
+            return;
+        }
+    }
+    auto state = source;
+    state.prim.fst = true;
+    state.linearFilter = false;
+    state.context.clamp = 5; // Decode texels; the GPU performs wrapping/filtering.
+    state.textureWidth = static_cast<uint16_t>(width);
+    state.textureHeight = static_cast<uint16_t>(height);
+    for (uint32_t y = 0; y < height; ++y)
+        for (uint32_t x = 0; x < width; ++x)
+            out[size_t(y) * width + x] = SampleTexture(state, 0, 0, 1, x << 4, y << 4);
+}
