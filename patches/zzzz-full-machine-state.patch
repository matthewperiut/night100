+void EeScheduler::validateStateSerializable() const
+{
+    if(m_guestExecuting.load(std::memory_order_acquire))
+        throw ps2x::state::NotReady("EE snapshot requires an unwound dispatcher safepoint");
+    if(!m_rdram || m_threads.empty())throw ps2x::state::NotReady("EE kernel is not initialized");
+    if(m_insideInterrupt)throw ps2x::state::NotReady("EE interrupt has not unwound");
+    auto invocation=[](const GuestInvocation &call) {
+        if(call.onComplete)throw ps2x::state::NotReady("EE invocation has an active host continuation");
+    };
+    for(const auto &[id,thread]:m_threads)
+    {
+        if(thread.wait.completion)throw ps2x::state::NotReady("EE thread "+std::to_string(id)+" has an active wait continuation");
+        if(thread.resumeCompletion)throw ps2x::state::NotReady("EE thread "+std::to_string(id)+" has an active resume continuation");
+        for(const auto &call:thread.invocations)invocation(call);
+    }
