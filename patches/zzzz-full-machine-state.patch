+bool ResourceDisc::read(uint64_t offset,void* destination,size_t length,size_t& bytesRead) {
+    bytesRead=0;if(!destination && length)return false;
+    if(!length || offset>=size())return true;
+    const uint64_t available=size()-offset;
+    const size_t wanted=static_cast<size_t>(std::min<uint64_t>(length,available));
+    auto* output=static_cast<uint8_t*>(destination);
+    std::lock_guard lock(m_impl->mutex);
+    auto found=std::upper_bound(m_impl->extents.begin(),m_impl->extents.end(),offset,
+        [](uint64_t value,const Impl::Extent& extent){return value<extent.logical;});
+    if(found==m_impl->extents.begin())return false;
+    --found;
+    while(bytesRead<wanted) {
+        const auto& extent=*found;
+        const uint64_t within=offset+bytesRead-extent.logical;
+        const size_t part=static_cast<size_t>(std::min<uint64_t>(wanted-bytesRead,extent.length-within));
+        if(extent.encoding==1)std::memset(output+bytesRead,0,part);
+        else if(extent.encoding==0) {
+            if(!m_impl->readFile(extent,within,output+bytesRead,part))return false;
+        } else {
+            if(!m_impl->decode(static_cast<size_t>(found-m_impl->extents.begin())))return false;
+            std::memcpy(output+bytesRead,m_impl->inflated.data()+within,part);
+        }
+        bytesRead+=part;++found;
+    }
+    return true;
+}
