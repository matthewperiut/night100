+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <chrono>
+#include <limits>
+#if defined(__APPLE__)
+#include <mach/mach_time.h>
+#elif defined(__SWITCH__)
+#include <switch/arm/counter.h>
+#endif
+
+namespace ps2x::iop
+{
+    // Native ports can spend substantial host time inside one guest function.
+    // Their asynchronous devices must follow the same monotonic clock as the
+    // port's platform timer, rather than an estimate of translated instructions.
+    // Deterministic/reference execution retains the supplied EE cycle budget.
+    class IopHostClock
+    {
+    public:
+        static constexpr uint64_t EeClockHz = 294912000u;
+        static constexpr uint64_t MinimumAdvance = EeClockHz / 1000u;
+        static constexpr uint64_t MaximumAdvance = EeClockHz / 200u;
+
+        // libnx system-counter ticks are 19.2MHz: 625/12 nanoseconds each.
+        // The common product is safe for almost 49 years of uptime. Split the
+        // exceptional range and saturate before the returned units overflow.
+        static constexpr uint64_t systemTicksToNanoseconds(uint64_t ticks) noexcept
+        {
+            if (ticks <= UINT64_MAX / 625u)return ticks * 625u / 12u;
+            const uint64_t whole = ticks / 12u, fraction = (ticks % 12u) * 625u / 12u;
+            if (whole > UINT64_MAX / 625u)return UINT64_MAX;
+            const uint64_t base = whole * 625u;
+            return fraction > UINT64_MAX - base ? UINT64_MAX : base + fraction;
+        }
+
+        static uint64_t monotonicNanoseconds() noexcept
+        {
+#if defined(__APPLE__)
+            // libc++ steady_clock uses this same continuous clock, including
+            // system sleep. Cache its fixed conversion instead of asking
+            // clock_gettime for the timebase at every EE checkpoint.
+            struct Timebase
+            {
+                uint32_t numerator = 1, denominator = 1;
+                uint64_t directLimit = UINT64_MAX;
+                Timebase() noexcept
+                {
+                    mach_timebase_info_data_t value{};
+                    if (mach_timebase_info(&value) == KERN_SUCCESS && value.numer && value.denom)
+                    {
+                        numerator = value.numer;
+                        denominator = value.denom;
+                        directLimit = UINT64_MAX / numerator;
+                    }
+                }
+            };
+            static const Timebase timebase;
+            const uint64_t ticks = mach_continuous_time();
+            if (ticks <= timebase.directLimit)
+                return ticks * timebase.numerator / timebase.denominator;
+            // Preserve the clock domain without overflowing the intermediate
+            // product after an unusually long system uptime.
+            return (ticks / timebase.denominator) * timebase.numerator +
+                ((ticks % timebase.denominator) * timebase.numerator) / timebase.denominator;
+#elif defined(__SWITCH__)
+            // libnx's generic MONOTONIC wrapper converts through timespec and
+            // its boot wall-time offset. IOP keeps only elapsed host time;
+            // reset, advance, pause/resume and archive rebasing all use this
+            // one uptime domain. Read the SDK counter directly, with no SVC.
+            return systemTicksToNanoseconds(armGetSystemTick());
+#else
+            return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count());
+#endif
+        }
+
+        void setRealtime(bool enabled) { m_realtime = enabled; }
+        [[nodiscard]] bool realtime() const { return m_realtime; }
+        void reset(uint64_t monotonicNanoseconds)
+        {
+            m_epoch = monotonicNanoseconds;
+            m_elapsedOffset = 0;
+            m_deadline = 0;
+        }
+
+        uint64_t advance(uint64_t emulatedEeCycles, uint64_t monotonicNanoseconds)
+        {
+            if (!m_realtime) return emulatedEeCycles;
+            if (m_paused) return 0;
+            if (monotonicNanoseconds < m_epoch) return 0;
+            const uint64_t sinceEpoch = monotonicNanoseconds - m_epoch;
+            const uint64_t elapsed = sinceEpoch > UINT64_MAX-m_elapsedOffset ? UINT64_MAX : sinceEpoch+m_elapsedOffset;
+            // Split before multiplying: even UINT64_MAX nanoseconds cannot
+            // overflow either product, and absolute conversion avoids drift.
+            const uint64_t target = (elapsed / 1000000000u) * EeClockHz +
+                ((elapsed % 1000000000u) * EeClockHz) / 1000000000u;
+            if (target <= m_deadline || target - m_deadline < MinimumAdvance) return 0;
+            // Service at least once per millisecond when checkpoints allow,
+            // and bound work requested by one call after a debugger/host pause.
+            // Preserve the absolute deadline debt; do not skip driver state.
+            const uint64_t credit = std::min(target - m_deadline, MaximumAdvance);
+            m_deadline += credit;
+            return credit;
+        }
+
+        // Preserve logical elapsed time and fractional batching credit while
+        // rebasing the host epoch. Another process/boot has a different epoch.
+        template<class Archive>void state(Archive &ar)
+        {
+            const uint64_t now=monotonicNanoseconds();
+            const uint64_t sinceEpoch=!m_paused && now>=m_epoch?now-m_epoch:0;
+            uint64_t elapsed=sinceEpoch>UINT64_MAX-m_elapsedOffset?UINT64_MAX:sinceEpoch+m_elapsedOffset;
+            ar(m_realtime,elapsed,m_deadline);
+            if constexpr(Archive::loading){m_epoch=now;m_elapsedOffset=elapsed;}
+        }
+        void pause()
+        {
+            if(m_paused)return;
+            const uint64_t now=monotonicNanoseconds();
+            const uint64_t elapsed=now>=m_epoch?now-m_epoch:0;
+            m_elapsedOffset=elapsed>UINT64_MAX-m_elapsedOffset?UINT64_MAX:elapsed+m_elapsedOffset;
+            m_epoch=now;m_paused=true;
+        }
+        void resume(){m_epoch=monotonicNanoseconds();m_paused=false;}
+        void excludeHostTime(uint64_t nanoseconds) noexcept
+        {
+            // An enclosing movie/snapshot pause already excludes this time
+            // when resume() rebases its epoch. Preserve any prior device debt.
+            if (m_paused) return;
+            m_epoch = nanoseconds > UINT64_MAX - m_epoch ? UINT64_MAX : m_epoch + nanoseconds;
+        }
+
+    private:
+        bool m_realtime = false;
+        bool m_paused = false;
+        uint64_t m_epoch = 0, m_elapsedOffset = 0, m_deadline = 0;
+    };
+}
