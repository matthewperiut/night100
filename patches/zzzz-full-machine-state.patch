+inline bool threadTicksToNanoseconds(uint64_t ticks,uint64_t& value) noexcept {
+    constexpr auto limit=std::numeric_limits<uint64_t>::max();
+    const uint64_t whole=ticks/12,remainder=(ticks%12)*625/12;
