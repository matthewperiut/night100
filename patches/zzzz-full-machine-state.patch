+void PS2AudioBackend::submitPcm(const int16_t *samples, size_t stereoFrames)
+{
+    if (!m_audioReady || !samples || !stereoFrames) return;
+    auto &impl = *m_impl;
+    const auto oldNonzero = impl.nonzeroFrames;
+    for (size_t i = 0; i < stereoFrames; ++i)
+    {
+        impl.nonzeroFrames += samples[i * 2] != 0 || samples[i * 2 + 1] != 0;
+        impl.peak = std::max(impl.peak, uint32_t(std::max(std::abs(int(samples[i * 2])),
+                                                       std::abs(int(samples[i * 2 + 1])))));
+    }
+    impl.generatedFrames += stereoFrames;
+    const size_t dropped = stereoFrames - impl.pcm.write(samples, stereoFrames);
+    impl.droppedFrames += dropped;
+    if (impl.profile) impl.recordBatch(stereoFrames, dropped);
+    if (!oldNonzero && impl.nonzeroFrames)
+        std::cout << "[SPU2 audio] first nonzero hardware PCM, peak=" << impl.peak << '\n';
+    if (impl.capture)
+    {
+        const uint64_t first = impl.generatedFrames - stereoFrames;
+        const uint64_t start = std::max(first, impl.captureStartFrame);
+        const uint64_t end = std::min(impl.generatedFrames, impl.captureStartFrame + impl.captureLimitFrames);
+        const size_t count = end > start ? size_t(end - start) : 0;
+        if (count) std::fwrite(samples + size_t(start - first) * 2, sizeof(int16_t) * 2, count, impl.capture);
+        impl.capturedFrames += uint32_t(count);
+    }
