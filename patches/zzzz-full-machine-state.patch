+const GSCpuBackend::SurfaceAddressMap *GSCpuBackend::SurfaceAddresses(uint32_t psm, uint32_t bw, uint32_t width, uint32_t height) const
+{
+    // Only the address layout is cached, never VRAM contents. Surface bases
+    // are page aligned; adding them and wrapping remains part of each access.
+    uint32_t layout = psm & 0x3fu;
+    if (layout == GS_PSM_CT24) layout = GS_PSM_CT32;
+    if (layout == GS_PSM_Z24) layout = GS_PSM_Z32;
+    uint32_t (*address)(uint32_t, uint32_t, uint32_t, uint32_t) = nullptr;
+    switch (layout)
+    {
+    case GS_PSM_CT32: address = GSPSMCT32::addrPSMCT32; break;
+    case GS_PSM_Z32:
+        // Depth toggles bits 3 and 4 in the page's color block ID.
+        address = [](uint32_t base, uint32_t stride, uint32_t x, uint32_t y) {
+            return GSPSMCT32::addrPSMCT32(base, stride, x, y) ^ 0x1800u;
+        }; break;
+    case GS_PSM_CT16: address = GSPSMCT16::addrPSMCT16; break;
+    case GS_PSM_CT16S: address = GSPSMCT16::addrPSMCT16S; break;
+    case GS_PSM_Z16: address = GSPSMCT16::addrPSMZ16; break;
+    case GS_PSM_Z16S: address = GSPSMCT16::addrPSMZ16S; break;
+    default: return nullptr;
+    }
+    // Four bounded entries cover ordinary color/depth target alternation.
+    // Oversized/unusual extents retain the existing scalar implementation.
+    if (!width || !height || size_t(width) * height > 1024u * 1024u) return nullptr;
+    SurfaceAddressMap *entry = nullptr;
+    for (auto &candidate : m_surfaceAddressMaps)
+        if (candidate.layout == layout && candidate.bw == bw && candidate.width == width)
+        { entry = &candidate; break; }
+    if (!entry)
+    {
+        entry = &*std::min_element(m_surfaceAddressMaps.begin(), m_surfaceAddressMaps.end(),
+            [](const auto &a, const auto &b) { return a.used < b.used; });
+        entry->width = width; entry->height = 0; entry->bw = bw; entry->layout = layout;
+        entry->offsets.clear();
+    }
+    entry->used = ++m_surfaceAddressClock;
+    if (entry->height < height)
+    {
+        entry->offsets.resize(size_t(width) * height);
+        for (uint32_t y = entry->height; y < height; ++y)
+            for (uint32_t x = 0; x < width; ++x)
+                entry->offsets[size_t(y) * width + x] = address(0u, bw, x, y);
+        entry->height = height;
+    }
+    return entry;
+}
+
+namespace
+{
+    // Fixed-width loads/stores are memcpy based to preserve unaligned/aliasing
+    // semantics. The compiler emits native loads for the aligned GS addresses.
+    template<typename T> uint32_t readSurfaceWord(const uint8_t *vram, uint32_t address)
+    {
+        T value;
+        std::memcpy(&value, vram + address, sizeof(T));
+        return value;
+    }
+    template<typename T> void writeSurfaceWord(uint8_t *vram, uint32_t address, uint32_t value)
+    {
+        const T packed = static_cast<T>(value);
+        std::memcpy(vram + address, &packed, sizeof(T));
+    }
+}
+
+void GSCpuBackend::ReadSurface(const GSContext &ctx, uint32_t width, uint32_t height, std::vector<uint32_t> &out) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    out.resize(size_t(width) * height * 2);
+    if (!m_vram) { std::fill(out.begin(), out.end(), 0u); return; }
+    const auto bw = std::max(1u, ctx.frame.fbw);
+    const auto *color = SurfaceAddresses(ctx.frame.psm, bw, width, height);
+    const auto *depth = SurfaceAddresses(ctx.zbuf.psm, bw, width, height);
+    if (!color || !depth)
+    {
+        for (uint32_t y = 0; y < height; ++y)
+            for (uint32_t x = 0; x < width; ++x) {
+                const size_t i = (size_t(y) * width + x) * 2;
+                out[i] = ReadVramUnlocked(ctx.frame.psm, ctx.frame.fbp << 5, bw, x, y);
+                out[i+1] = ReadVramUnlocked(ctx.zbuf.psm, ctx.zbuf.zbp << 5, bw, x, y);
+            }
+        return;
+    }
+    const uint32_t colorBase = ctx.frame.fbp << 13u, depthBase = ctx.zbuf.zbp << 13u;
+    const uint32_t colorPsm = ctx.frame.psm & 0x3fu, depthPsm = ctx.zbuf.psm & 0x3fu;
+    const bool color16 = colorPsm == GS_PSM_CT16 || colorPsm == GS_PSM_CT16S || colorPsm == GS_PSM_Z16 || colorPsm == GS_PSM_Z16S;
+    const bool depth16 = depthPsm == GS_PSM_CT16 || depthPsm == GS_PSM_CT16S || depthPsm == GS_PSM_Z16 || depthPsm == GS_PSM_Z16S;
+    const uint32_t colorMask = (colorPsm == GS_PSM_CT24 || colorPsm == GS_PSM_Z24) ? 0xffffffu : ~0u;
+    const uint32_t depthMask = (depthPsm == GS_PSM_CT24 || depthPsm == GS_PSM_Z24) ? 0xffffffu : ~0u;
+    auto copy = [&]<typename Color, typename Depth>() {
+        for (size_t pixel = 0, count = size_t(width) * height; pixel < count; ++pixel)
+        {
+            const uint32_t ca = (colorBase + color->offsets[pixel]) & (GSMem::MEMORY_SIZE - sizeof(Color));
+            const uint32_t za = (depthBase + depth->offsets[pixel]) & (GSMem::MEMORY_SIZE - sizeof(Depth));
+            out[pixel * 2] = readSurfaceWord<Color>(m_vram, ca) & colorMask;
+            out[pixel * 2 + 1] = readSurfaceWord<Depth>(m_vram, za) & depthMask;
+        }
+    };
+    if (color16) { if (depth16) copy.template operator()<uint16_t, uint16_t>(); else copy.template operator()<uint16_t, uint32_t>(); }
+    else { if (depth16) copy.template operator()<uint32_t, uint16_t>(); else copy.template operator()<uint32_t, uint32_t>(); }
+}
+
+void GSCpuBackend::WriteSurface(const GSContext &ctx, uint32_t width, uint32_t height, const std::vector<uint32_t> &pixels, const std::vector<uint32_t> &before, uint32_t writePlanes, uint32_t forcePlanes)
+{
+    if (pixels.size() != size_t(width) * height * 2 || before.size() != pixels.size())
+        throw std::invalid_argument("Invalid GS surface interchange size");
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_vram) return;
+    const bool writeColor=(writePlanes&1)!=0, writeDepth=(writePlanes&2)!=0;
+    const bool forceColor=(forcePlanes&1)!=0, forceDepth=(forcePlanes&2)!=0;
+    const auto bw = std::max(1u, ctx.frame.fbw);
+    const auto *color = SurfaceAddresses(ctx.frame.psm, bw, width, height);
+    const auto *depth = SurfaceAddresses(ctx.zbuf.psm, bw, width, height);
+    if (!color || !depth)
+    {
+        for (uint32_t y = 0; y < height; ++y)
+            for (uint32_t x = 0; x < width; ++x) {
+                const size_t i = (size_t(y) * width + x) * 2;
+                if (writeColor && (forceColor || before[i] != pixels[i])) WriteVramUnlocked(ctx.frame.psm, ctx.frame.fbp << 5, bw, x, y, pixels[i]);
+                if (writeDepth && (forceDepth || before[i+1] != pixels[i+1])) WriteVramUnlocked(ctx.zbuf.psm, ctx.zbuf.zbp << 5, bw, x, y, pixels[i+1]);
+            }
+        return;
+    }
+    const uint32_t colorBase = ctx.frame.fbp << 13u, depthBase = ctx.zbuf.zbp << 13u;
+    const uint32_t colorPsm = ctx.frame.psm & 0x3fu, depthPsm = ctx.zbuf.psm & 0x3fu;
+    const bool color16 = colorPsm == GS_PSM_CT16 || colorPsm == GS_PSM_CT16S || colorPsm == GS_PSM_Z16 || colorPsm == GS_PSM_Z16S;
+    const bool depth16 = depthPsm == GS_PSM_CT16 || depthPsm == GS_PSM_CT16S || depthPsm == GS_PSM_Z16 || depthPsm == GS_PSM_Z16S;
+    const bool color24 = colorPsm == GS_PSM_CT24 || colorPsm == GS_PSM_Z24;
+    const bool depth24 = depthPsm == GS_PSM_CT24 || depthPsm == GS_PSM_Z24;
+    auto copy = [&]<typename Color, typename Depth>() {
+        for (size_t block = 0, count = size_t(width) * height; block < count; block += 8)
+        {
+            // Reserved screen targets often contain large untouched regions.
+            // Compare one cache line before loading either address map; equal
+            // blocks need no scatter or per-component branches. Changed blocks
+            // retain the original pixel/color/depth order for overlapping VRAM.
+            if (!(forcePlanes&writePlanes) && block + 8 <= count && before[block * 2] == pixels[block * 2]
+                && before[block * 2 + 1] == pixels[block * 2 + 1]
+                && std::memcmp(before.data() + block * 2,
+                pixels.data() + block * 2, 64) == 0) continue;
+            for (size_t pixel = block, end = std::min(count, block + 8); pixel < end; ++pixel)
+            {
+                const size_t i = pixel * 2;
+                // Preserve the original color-then-depth order at every pixel,
+                // including overlapping color/depth targets and wrapped addresses.
+                if (writeColor && (forceColor || before[i] != pixels[i]))
+                {
