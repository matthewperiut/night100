+++ b/ps2xIOP/src/emulator/core/iop_spu2.h
@@ -0,0 +1,467 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <span>
+#include <string>
+#include <stdexcept>
+#include <vector>
+#include "runtime/cpu_work_profile.h"
+
+namespace ps2x::iop::detail
+{
+    // SPU2 register/ADPCM semantics follow the documented hardware layout and
+    // PCSX2 SPU2/{regs.h,RegTable.cpp,Mixer.cpp,ADSR.cpp} (GPL-3.0+).
+    // This is a direct-voice model: effects, noise and auto-DMA are not yet mixed.
+    // Sample RAM is independent of IOP RAM; all DMA uploads copy explicitly.
+    class IopSpu2
+    {
+    public:
+        static constexpr uint32_t RamBytes = 2u * 1024u * 1024u;
+        static constexpr uint32_t RamMask = RamBytes - 1u;
+        static constexpr uint64_t CyclesPerSample = 768u; // 36.864 MHz / 48 kHz
+
+        IopSpu2() : m_ram(RamBytes)
+        {
+            if (const char *path = std::getenv("NIGHT100_CAPTURE_SPU"))
+            {
+                m_capturePath = path;
+                m_events = std::make_unique<CaptureEvent[]>(CaptureEvents);
+            }
+            if (const char *path = std::getenv("NIGHT100_SPU_WORK_COUNTERS")) m_workPath = path;
+            const char *reference = std::getenv("NIGHT100_REFERENCE_SPU_MIX");
+            m_referenceMix = !reference || (reference[0] && reference[0] != '0');
+            reset();
+        }
+        ~IopSpu2() { saveCapture(); saveWorkCounters(); }
+        void reset()
+        {
+            std::fill(m_ram.begin(), m_ram.end(), 0);
+            m_registers.fill(0);
+            m_voices = {};
+            m_envelopes = {};
+            for (unsigned voice = 0; voice < 48; ++voice) refreshEnvelope(voice);
+            m_active = 0;
+            m_nextSample = CyclesPerSample;
+            m_pcm.clear();
+            m_eventCount = 0;
+            for (unsigned core = 0; core < 2; ++core)
+                setMask(core, 0x340, 0xffffffu);
+        }
+
+        uint16_t read(uint32_t offset) const { if (!m_workPath.empty()) ++m_work.reads; return readRegister(offset); }
+        uint32_t address(unsigned core, uint32_t offset) const
+        {
+            const uint32_t base = core * 0x400u + offset;
+            return ((uint32_t(readRegister(base)) << 16u) | readRegister(base + 2u)) & 0xfffffu;
+        }
+        void write(uint32_t offset, uint16_t value)
+        {
+            if (!m_workPath.empty()) ++m_work.writes;
+            offset &= 0x7feu;
+            if (!m_capturePath.empty()) recordEvent('W', offset, value, 0);
+            const unsigned core = (offset >> 10u) & 1u;
+            const uint32_t reg = offset & 0x3ffu;
+            // ENDX acknowledges only bits written as one.
+            if (reg == 0x340u || reg == 0x342u)
+            {
+                m_registers[offset / 2u] &= ~value;
+                return;
+            }
+            m_registers[offset / 2u] = value;
+            if (reg < 0x180u && ((reg & 15u) == 6u || (reg & 15u) == 8u))
+                refreshEnvelope(core * 24u + reg / 16u);
+            if (reg == 0x1a0u || reg == 0x1a2u || reg == 0x1a4u || reg == 0x1a6u)
+            {
+                const bool on = reg < 0x1a4u;
+                const unsigned first = (reg & 2u) ? 16u : 0u;
+                for (unsigned bit = 0; bit < 16 && first + bit < 24; ++bit)
+                {
+                    if (!(value & (1u << bit))) continue;
+                    const unsigned index = core * 24u + first + bit;
+                    Voice &voice = m_voices[index];
+                    if (on)
+                    {
+                        voice = {};
+                        voice.phase = Attack;
+                        voice.block = address(core, 0x1c0u + (first + bit) * 12u) & ~7u;
+                        voice.loop = address(core, 0x1c4u + (first + bit) * 12u) & ~7u;
+                        voice.sample = 28;
+                        m_active |= uint64_t{1} << index;
+                        setMask(core, 0x340u, mask(core, 0x340u) & ~(1u << (first + bit)));
+                        setAddress(core, 0x1c8u + (first + bit) * 12u, voice.block);
+                        m_registers[(core * 0x400u + (first + bit) * 16u + 0xau) / 2u] = 0;
+                    }
+                    else if (voice.phase != Off)
+                    {
+                        voice.phase = Release;
+                        voice.counter = 0;
+                    }
+                }
+            }
+            else if (reg >= 0x1c0u && reg < 0x2e0u)
+            {
+                const unsigned voiceIndex = (reg - 0x1c0u) / 12u;
+                const unsigned part = (reg - 0x1c0u) % 12u;
+                if (part == 4u || part == 6u)
+                {
+                    Voice &voice = m_voices[core * 24u + voiceIndex];
+                    voice.loop = address(core, 0x1c4u + voiceIndex * 12u) & ~7u;
+                    voice.manualLoop = voice.phase != Off;
+                }
+            }
+            else if (reg == 0x1acu)
+            {
+                uint32_t destination = address(core, 0x1a8u) * 2u;
+                m_ram[destination & RamMask] = uint8_t(value);
+                m_ram[(destination + 1u) & RamMask] = uint8_t(value >> 8u);
+                setAddress(core, 0x1a8u, (destination / 2u + 1u) & 0xfffffu);
+            }
+        }
+
+        void transfer(unsigned core, std::span<uint8_t> iopRam, uint32_t source, uint64_t bytes, bool toSpu)
+        {
+            if (!m_workPath.empty()) { ++m_work.transfers; m_work.transferBytes += bytes; }
+            uint32_t destination = address(core, 0x1a8u) * 2u;
+            if (!m_capturePath.empty()) recordEvent(toSpu ? 'D' : 'R', core, destination, bytes);
+            for (uint64_t i = 0; i < bytes; ++i)
+            {
+                const uint32_t io = (source + uint32_t(i)) & (uint32_t(iopRam.size()) - 1u);
+                if (toSpu) m_ram[(destination + i) & RamMask] = iopRam[io];
+                else iopRam[io] = m_ram[(destination + i) & RamMask];
+            }
+            setAddress(core, 0x1a8u, ((destination + uint32_t(bytes)) / 2u) & 0xfffffu);
+            m_registers[(core * 0x400u + 0x344u) / 2u] |= 0x80u;
+        }
+
+        void advanceTo(uint64_t cycles)
+        {
+            const uint64_t count = cycles < m_nextSample ? 0 : (cycles - m_nextSample) / CyclesPerSample + 1;
+            CpuWorkProfile::Scope cpuWork(CpuWorkProfile::Phase::Spu,count!=0);
+            if (!m_workPath.empty())
+            {
+                ++m_work.advances;
+                ++m_work.batches[count == 0 ? 0 : count == 1 ? 1 : count < 4 ? 2 : count < 16 ? 3 : count < 64 ? 4 : count < 256 ? 5 : 6];
+                m_work.samples += count;
+            }
+            if (m_referenceMix || count < 2)
+            {
+                for (uint64_t i = 0; i < count; ++i) mixSample();
+            }
+            else
+            {
+                // The guest cannot read/write registers or RAM during advanceTo.
+                // Voice state is independent; only the per-core integer sums and
+                // ENDX ORs are shared. A block changes neither visible boundaries
+                // nor sample/envelope arithmetic, and adds no buffering latency.
+                uint64_t left = count;
+                while (left)
+                {
+                    const unsigned block = unsigned(std::min<uint64_t>(left, MixBlock));
+                    mixBlock(block);
+                    left -= block;
+                }
+            }
+            m_nextSample += count * CyclesPerSample;
+        }
+        std::span<const int16_t> audioSamples() const { return m_pcm; }
+        void clearAudioSamples() { m_pcm.clear(); }
+
+        static std::vector<uint64_t> stateAbi() {return {1,sizeof(Voice),alignof(Voice),sizeof(EnvelopeStep),alignof(EnvelopeStep),sizeof(m_voices),alignof(decltype(m_voices)),sizeof(m_envelopes),alignof(decltype(m_envelopes))};}
+        template<class A> void state(A& ar) { ar(m_ram,m_registers); ar.pod(m_voices); ar.pod(m_envelopes); ar(m_active,m_nextSample,m_pcm); if(m_ram.size()!=RamBytes || m_pcm.size()>192000u || (m_active>>48)) throw std::runtime_error("Invalid SPU2 state"); for(const auto& voice:m_voices)if(voice.phase>Release || voice.sample>28)throw std::runtime_error("Invalid SPU2 voice state"); }
+
+    private:
+        uint16_t readRegister(uint32_t offset) const { return m_registers[(offset & 0x7ffu) / 2u]; }
+        struct WorkCounters
+        {
+            uint64_t advances=0, samples=0, voiceSamples=0, decodes=0, reads=0, writes=0, transfers=0, transferBytes=0;
+            std::array<uint64_t,7> batches{};
+        };
+        void saveWorkCounters() const
+        {
+            if (m_workPath.empty()) return;
+            if (auto *file = std::fopen(m_workPath.c_str(), "w"))
+            {
