+// EE scalar arithmetic runs with chop/zero rounding. Scope this at dispatch
+// boundaries so nested translated calls share the hardware mode without a
+// control-register write for every arithmetic operation. Scheduler work and
+// other host threads retain their own environment. VU interpreters independently
+// establish and restore their rounding mode.
+class EeFloatEnvironment
+{
+    int previous = std::fegetround();
+public:
+    EeFloatEnvironment()
+    {
+        if (previous < 0 || (previous != FE_TOWARDZERO && std::fesetround(FE_TOWARDZERO)))
+            throw std::runtime_error("Cannot establish EE chop/zero rounding");
+    }
+    ~EeFloatEnvironment()
+    {
+        if (previous != FE_TOWARDZERO)
+            std::fesetround(previous);
+    }
+    EeFloatEnvironment(const EeFloatEnvironment&) = delete;
+    EeFloatEnvironment& operator=(const EeFloatEnvironment&) = delete;
+};
