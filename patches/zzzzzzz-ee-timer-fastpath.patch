+uint64_t PS2Memory::eeTimerCyclesToEvent() const noexcept
+{
+    // The exact distance formula assumes canonical phases. A noncanonical
+    // restored phase keeps the eager path until one checkpoint canonicalizes it.
+    for (const EeTimer &timer : m_eeTimers)
+    {
+        if (timer.clockRemainder >= kEeClockHz)
+        {
+            return 0u;
+        }
+    }
+    return cyclesUntilNextEeTimerInterrupt();
+}
 
