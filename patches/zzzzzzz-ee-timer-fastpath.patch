+uint32_t PS2Memory::advanceEeTimers(uint64_t eeCycles) noexcept
+{
+    if (eeCycles == 0u)
+    {
+        return 0u;
+    }
+    // Eager form: apply any deferred cycles first, then this checkpoint. The
+    // logical timer time moves outside the cached distance, so invalidate it.
+    flushEeTimers();
+    m_eeTimerNextEventValid = false;
+    clearGifFqcForCheckpoint();
+    return takeEeTimerInterrupts() | advanceEeTimerClocks(eeCycles);
+}
+
+void PS2Memory::flushEeTimers() noexcept
+{
+    // Deferred cycles were proven to contain no interrupt, so the result is
+    // always empty here; it is latched anyway and never dropped.
+    const uint64_t pending = m_eeTimerPendingCycles;
+    if (pending == 0u)
+    {
+        return;
+    }
+    m_eeTimerPendingCycles = 0u;
+    m_eeTimerLatchedInterrupts |= advanceEeTimerClocks(pending);
+}
+
+uint32_t PS2Memory::takeEeTimerInterrupts() noexcept
+{
+    const uint32_t mask = m_eeTimerLatchedInterrupts;
+    m_eeTimerLatchedInterrupts = 0u;
+    return mask;
+}
