+// Per-program VU1 histogram keyed by MSCAL start address (bytes into VU1 code memory).
+// Programs beyond kMaxPrograms accumulate in `other`. Only array updates on the MSCAL path.
+struct VU1ProgramHistogram
+{
+    static constexpr uint32_t kMaxPrograms = 64;
+    struct Entry
+    {
+        uint32_t pc = 0;
+        uint64_t calls = 0;        // MSCAL/MSCALF starts
+        uint64_t execNs = 0;       // host nanoseconds spent executing the program
+        uint64_t xgkickStarts = 0; // XGKICK transfers the program started
+        uint64_t eeReads = 0;      // EE reads of VU1 data memory after this program last returned
+    };
+    std::array<Entry, kMaxPrograms> entries{};
+    Entry other{};
+    uint32_t count = 0;   // used entries in `entries`
+    uint32_t lastSlot = 0; // cache of the most recently matched entry
+
+    Entry &slot(uint32_t index) { return index < kMaxPrograms ? entries[index] : other; }
+    const Entry &slot(uint32_t index) const { return index < kMaxPrograms ? entries[index] : other; }
+};
+
+// One line per program, sorted by execute time descending, prefixed with "[vu1-prog] replay=N".
+std::vector<std::string> formatVU1ProgramHistogram(const VU1ProgramHistogram &histogram, int replayId);
