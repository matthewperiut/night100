-void PS2Memory::recordVU1Mscal()
+uint32_t PS2Memory::selectVU1ProgramSlot(uint32_t startPC)
+{
+    VU1ProgramHistogram &histogram = m_vu1Programs;
+    if (histogram.lastSlot < histogram.count && histogram.entries[histogram.lastSlot].pc == startPC)
+        return histogram.lastSlot;
+    for (uint32_t i = 0; i < histogram.count; ++i)
+    {
+        if (histogram.entries[i].pc == startPC)
+        {
+            histogram.lastSlot = i;
+            return i;
+        }
+    }
+    if (histogram.count < VU1ProgramHistogram::kMaxPrograms)
+    {
+        const uint32_t index = histogram.count++;
+        histogram.entries[index].pc = startPC;
+        histogram.lastSlot = index;
+        return index;
+    }
+    return VU1ProgramHistogram::kMaxPrograms; // table full: accumulate in `other`
+}
+
+void PS2Memory::recordVU1Mscal(uint32_t startPC)
 {
     ++m_vu1Stats.mscalCalls;
+    m_vu1ActiveSlot = selectVU1ProgramSlot(startPC);
+    ++m_vu1Programs.slot(m_vu1ActiveSlot).calls;
+    m_vu1XgkickBase = m_vu1Stats.xgkickStarts;
     const uint64_t generation = getVU1CodeGeneration();
     if (generation == m_vu1StatsHashedGeneration || !m_vu1Code)
         return;
@@ -2644,3 +2680,38 @@ void PS2Memory::recordVU1Mscal()
     }
     ++m_vu1Stats.distinctOverflow;
 }
