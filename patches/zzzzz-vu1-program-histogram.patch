+std::vector<std::string> formatVU1ProgramHistogram(const VU1ProgramHistogram &histogram, int replayId)
+{
+    // Ordering is computed here, outside the MSCAL path.
+    std::vector<uint32_t> order;
+    order.reserve(VU1ProgramHistogram::kMaxPrograms + 1);
+    for (uint32_t i = 0; i < histogram.count; ++i)
+        order.push_back(i);
+    if (histogram.other.calls != 0)
+        order.push_back(VU1ProgramHistogram::kMaxPrograms);
+    std::stable_sort(order.begin(), order.end(), [&](uint32_t a, uint32_t b)
+                     { return histogram.slot(a).execNs > histogram.slot(b).execNs; });
+
+    std::vector<std::string> lines;
+    lines.reserve(order.size());
+    for (uint32_t index : order)
+    {
+        const VU1ProgramHistogram::Entry &entry = index < VU1ProgramHistogram::kMaxPrograms ? histogram.entries[index] : histogram.other;
+        char text[256];
+        if (index < VU1ProgramHistogram::kMaxPrograms)
+            std::snprintf(text, sizeof(text), "[vu1-prog] replay=%d pc=0x%04x calls=%llu us=%.1f xgkick=%llu eeread=%llu",
+                          replayId, entry.pc, static_cast<unsigned long long>(entry.calls),
+                          static_cast<double>(entry.execNs) / 1000.0,
+                          static_cast<unsigned long long>(entry.xgkickStarts),
+                          static_cast<unsigned long long>(entry.eeReads));
+        else
+            std::snprintf(text, sizeof(text), "[vu1-prog] replay=%d pc=other calls=%llu us=%.1f xgkick=%llu eeread=%llu",
+                          replayId, static_cast<unsigned long long>(entry.calls),
+                          static_cast<double>(entry.execNs) / 1000.0,
+                          static_cast<unsigned long long>(entry.xgkickStarts),
+                          static_cast<unsigned long long>(entry.eeReads));
+        lines.emplace_back(text);
+    }
+    return lines;
+}
